<?xml version="1.0"?>
<package format="2">

  <name>clustering</name>
  <version>1.0.0</version>
  <description>Tree-based clustering of exploration points around the UAV</description>

  <maintainer email="pazoudav@fel.cvut.cz">David Pazout</maintainer>

  <license>BSD 3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>cmake_modules</depend>
  <depend>mrs_lib</depend>
  <depend>nodelet</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>mrs_msgs</depend>
  <depend>frontier_detector</depend>
  <depend>explorer_utils</depend>

  <export>
    <nodelet plugin="${prefix}/nodelets.xml" />
  </export>

</package>
