<launch>

  <arg name="UAV_NAME" default="$(env UAV_NAME)" />

  <arg name="world_info_file_config" default="" />

  <arg name="LOGGER_DEBUG" default="$(optenv LOGGER_DEBUG false)" />

  <!-- other args -->
  <arg name="debug" default="false" />
  <arg name="standalone" default="true" />
  <arg name="custom_config" default="" />

  <arg     if="$(arg debug)" name="launch_prefix" value="debug_roslaunch" />
  <arg unless="$(arg debug)" name="launch_prefix" value="" />

  <arg name="nodelet_manager_name" default="" />
  <arg     if="$(eval arg('standalone') or arg('debug'))" name="nodelet" value="standalone" />
  <arg unless="$(eval arg('standalone') or arg('debug'))" name="nodelet" value="load" />
  <arg     if="$(eval arg('standalone') or arg('debug'))" name="nodelet_manager" value="" />
  <arg unless="$(eval arg('standalone') or arg('debug'))" name="nodelet_manager" value="$(arg nodelet_manager_name)" />

  <group ns="$(arg UAV_NAME)">

    <node pkg="nodelet" type="nodelet" name="path_planner" args="$(arg nodelet) path_planner/PathPlannerNodelet $(arg nodelet_manager)" output="screen" launch-prefix="$(arg launch_prefix)" respawn="false">

      <rosparam file="$(find path_planner)/config/path_planner.yaml" command="load" />
      <rosparam file="$(arg world_info_file_config)" command="load" />

      <param name="uav_name" value="$(arg UAV_NAME)" />

      <!-- topics in -->
      <remap from="~tracker_cmd_in" to="control_manager/tracker_cmd" />
      <remap from="~octomap_in" to="octomap_server/octomap_local_binary" />
      <remap from="~diagnostics_in" to="control_manager/diagnostics" />
      <remap from="~frontiers_in" to="frontier_detector/frontiers" />

      <!-- services in -->
      <remap from="~find_simplified_path_in" to="~find_simplified_path" />

    </node>

  </group>

</launch>
