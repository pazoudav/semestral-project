#!/usr/bin/env bash
# Copy of the MRS /usr/bin/debug_roslaunch with gdb pagination turned off, put first in PATH by tmux/session.yml.
# -q drops the banner and -iex applies before anything is printed, a plain -ex runs only after the banner, too late.
# Without it gdb stops at "--Type <RET> for more, q to quit, c to continue without paging--" before even running the
# node when its split is small (e.g. a detached session started by scripts/crash_hunt.sh is only 80x24).

if [ $# -lt 1 ]; then
  echo "You must specify path to the executable to be debugged. Ending."
  exit 1;
fi

if [ -z $TMUX ]; then
  echo "You must be in tmux in order to create the split. Ending."
  exit 1;
fi

orig_tty=`tty`
tmpfile=$(mktemp /tmp/debug_roslaunch_env.XXXXXXXX)
export -p > $tmpfile
pre_cmd="source $HOME/.bashrc; source $tmpfile; rm $tmpfile"
gdb_cmd="gdb -q -iex 'set pagination off' -iex 'set width 0' -ex 'tty $orig_tty' -ex run --args $@"
cmd="$pre_cmd; $gdb_cmd; exit"
tmux split-window -h "bash -c \"$cmd\""
